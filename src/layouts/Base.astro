---
import '../styles/global.css';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Set false on pages that should not claim a canonical URL, such as 404. */
  canonical?: boolean;
}

const { title, description = site.description, canonical: withCanonical = true } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
// Clean URLs: "/index.html" becomes "/", "/privacy.html" becomes "/privacy".
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ''), site.url);
const ogImage = new URL('/og-image.png', site.url);
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {withCanonical && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#104032" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="preload"
      href="/fonts/fraunces-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/nunito-sans-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${site.name} logo. ${site.tagline} Art Cards by Hadley. ${site.domain}`}
    />
    <meta property="og:locale" content={site.locale.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        <a href="/privacy">Privacy</a>
      </p>
    </footer>
  </body>
</html>
