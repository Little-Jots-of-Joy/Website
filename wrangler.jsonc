// Cloudflare Workers configuration: serves the static Astro build. See ADR 0002.
// No `main` script: this is an assets-only Worker, so there is no server code.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "website",
  "compatibility_date": "2026-11-17",
  // Production is served only on the custom domain (littlejotsofjoy.ca, set in
  // the dashboard). Keep workers_dev explicit: if omitted, wrangler re-enables
  // the workers.dev address on every deploy.
  "workers_dev": false,
  // Branch previews for review (ADR 0006). They are public unless Cloudflare
  // Access is on: Worker > Access > "Previews only". Never set this to true
  // while Access is off.
  "preview_urls": true,
  // Workers Logs off: we keep no request-level visitor logs (privacy data
  // inventory, retention policy). Changing this needs a privacy update (rule 6).
  "observability": {
    "enabled": false,
  },
  "assets": {
    "directory": "./dist",
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page",
    // Clean URLs to match astro.config.ts (trailingSlash: 'never'): /privacy, not /privacy/.
    "html_handling": "drop-trailing-slash",
  },
}
