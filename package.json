{
  "name": "website",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "format": "prettier --write .",
    "check": "pnpm check:types && pnpm check:format && pnpm build && pnpm check:html && pnpm check:inline && pnpm check:images && pnpm check:links",
    "check:types": "astro check",
    "check:format": "prettier --check .",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:inline": "node scripts/check-inline.mjs",
    "check:images": "node scripts/check-image-metadata.mjs",
    "check:links": "lychee --offline --no-progress --include-fragments --fallback-extensions html --index-files index.html,. --root-dir \"$PWD/dist\" \"dist/**/*.html\" \"*.md\" \"docs/**/*.md\""
  },
  "dependencies": {
    "astro": "^7.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "html-validate": "^11.21.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.160.0"
  }
}
